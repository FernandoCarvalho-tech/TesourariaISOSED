# Copie para .env (NUNCA versione o .env) ou cadastre no Render > Environment.

# --- Obrigatórias -----------------------------------------------------------
# String de conexão do Postgres (Supabase: use a URL do pooler).
DATABASE_URL=postgresql://usuario:senha@host:5432/postgres
# Chave das sessões/CSRF, mínimo 32 caracteres. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Trocar a chave desloga todo mundo (não perde dados).
SECRET_KEY=

# --- Opcionais (valores padrão entre parênteses) ----------------------------
# producao (padrão): cookie só via HTTPS. dev: permite http://localhost.
APP_ENV=producao
# Minutos sem uso até a sessão expirar (240).
SESSAO_INATIVIDADE_MIN=240
# Saltos de proxy confiáveis à frente do app; no Render é 1 (1).
TRUSTED_PROXIES=1
# Fuso usado nas datas de efetivação/reabertura do fechamento.
APP_TIMEZONE=America/Sao_Paulo
LOG_LEVEL=INFO
HEALTHCHECK_TIMEOUT_S=5

# Limites de tentativa (sintaxe Flask-Limiter). Guardados em memória do
# processo; se um dia usar vários workers/instâncias, aponte para um Redis.
RATELIMIT_STORAGE_URI=memory://
LIMITE_LOGIN_IP=20 per 10 minutes
LIMITE_LOGIN_USUARIO=5 per 15 minutes
LIMITE_CADASTRO_IP=15 per hour
LIMITE_CONFIRMACAO_SENHA=10 per 15 minutes

# Captcha do cadastro público (Cloudflare Turnstile, gratuito). Deixe as duas
# vazias para desligar; preencha as duas para ligar.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_TIMEOUT_S=5

# Só para banco NOVO (sem nenhum usuário): cria o primeiro administrador.
# Remova do Render depois do primeiro acesso.
ADMIN_INICIAL_USUARIO=
ADMIN_INICIAL_SENHA=
